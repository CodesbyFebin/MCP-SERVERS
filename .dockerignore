# MCPserver.in — Docker build context filter
#
# Keep the build context small. Exclude everything that is not strictly required
# for the standalone Next.js build and runtime image.

# Dependency trees (re-installed inside the image)
node_modules/
**/node_modules/
**/node_modules/**

# Build output (regenerated inside the image)
.next/
out/
build/
dist/

# Source-control and editor metadata
.git/
.gitignore
.gitattributes
.DS_Store
.idea/
.vscode/

# Test artifacts and reports (only relevant for humans; the runtime does not need them)
coverage/
reports/
playwright-report/
test-results/
.nyc_output/

# Environment, secrets, and local-only files
.env
.env.local
.env.*.local
.npmrc
.pnpm-debug.log*

# ZCode session state (this assistant's working directory metadata)
.zcode/

# Documentation and human-only files (not needed by the runtime)
*.md
!app/**/*.md
docs/

# Internal scripts that are NOT used by the runtime (only by build-time tooling)
scripts/audit-reconciliation.ts
scripts/generate-canonical-map.ts

{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "start": "next start --port 3000",
    "prebuild": "tsx scripts/generate-llms-txt.mjs",
    "build": "tsx validate-seo.ts && next build --webpack",
    "postbuild": "node scripts/postbuild-indexnow.mjs",
    "format:check": "node scripts/format-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:build": "tsx scripts/content/content-pipeline.ts",
    "content:quality": "tsx scripts/content/quality-scorer.ts",
    "content:links": "tsx scripts/content/enhance-internal-links.ts",
    "content:comparisons": "tsx scripts/content/generate-comparison-pages.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "seo:audit": "tsx validate-seo.ts",
    "generate:phase-a": "node scripts/generate-phase-a-authority.mjs",
    "generate:5000-url-candidates": "node scripts/generate-master-content-registries.mjs",
    "verify:5000-count": "node scripts/generate-master-content-registries.mjs --verify-only --check=count",
    "verify:url-uniqueness": "node scripts/generate-master-content-registries.mjs --verify-only --check=url",
    "verify:canonical-uniqueness": "node scripts/generate-master-content-registries.mjs --verify-only --check=canonical",
    "verify:intent-ownership": "node scripts/generate-master-content-registries.mjs --verify-only --check=intent",
    "verify:entity-resolution": "node scripts/generate-master-content-registries.mjs --verify-only --check=entity",
    "verify:content": "tsx scripts/verify-phase-a-content.ts",
    "verify:links": "tsx scripts/verify-phase-a-links.ts",
    "audit:schema": "tsx scripts/audit-schema.mjs",
    "generate:content-dates": "node scripts/derive-content-dates.mjs",
    "seo:rankings": "node scripts/seo-rank-tracker.mjs",
    "verify:p99": "node scripts/verify-production.mjs",
    "verify:phase-a-production": "tsx scripts/verify-phase-a-production.ts",
    "verify:sitemap": "node scripts/verify-sitemap.mjs",
    "verify:sitemaps": "node scripts/verify-sitemap.mjs",
    "verify:intents": "tsx scripts/verify-intents.ts",
    "verify:redirects": "node scripts/verify-redirects.mjs",
    "verify:glossary-indexation": "tsx scripts/verify-glossary-indexation.ts",
    "verify:schema": "node scripts/verify-schema.mjs",
    "verify:entities": "tsx scripts/verify-entities.ts",
    "verify:robots": "tsx scripts/verify-robots.ts",
    "verify:canonicals": "tsx scripts/verify-canonicals.ts",
    "verify:claims": "node scripts/verify-claims.mjs",
    "verify:release": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run seo:audit && npm run verify:intents && npm run verify:content && npm run verify:links && npm run verify:claims && npm run build && npm run verify:canonicals && npm run verify:glossary-indexation && npm run verify:schema && npm run verify:redirects && npm run verify:production",
    "generate:llms": "node scripts/generate-llms-full.mjs",
    "generate:content": "node scripts/generate-content.mjs",
    "content:gaps": "node scripts/extract-content-gaps.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "submit-indexnow": "node scripts/submit-indexnow.mjs",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "generate:5000-content": "tsx scripts/content/generate-content-5000.ts",
    "publication:build": "tsx scripts/content/publication-registry.ts",
    "verify:generated-evidence": "tsx scripts/content/verify-publication.ts evidence",
    "verify:generated-similarity": "tsx scripts/content/verify-publication.ts similarity",
    "verify:generated-code": "tsx scripts/content/verify-publication.ts code",
    "verify:generated-claims": "tsx scripts/content/verify-publication.ts claims",
    "verify:generated-links": "tsx scripts/content/verify-publication.ts links",
    "verify:generated-intents": "tsx scripts/content/verify-publication.ts intents",
    "verify:publication-cohort": "tsx scripts/content/verify-publication.ts cohort",
    "verify:publication": "npm run verify:generated-evidence && npm run verify:generated-similarity && npm run verify:generated-code && npm run verify:generated-claims && npm run verify:generated-links && npm run verify:generated-intents && npm run verify:publication-cohort",
    "report:publication": "tsx scripts/content/report-publication.ts",
    "clean": "rm -rf dist .next"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@vercel/postgres": "^0.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fuse.js": "^7.5.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.16.0",
    "motion": "^12.23.24",
    "next": "^16.2.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "19.2.17",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}

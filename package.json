    "seo:audit": "tsx validate-seo.ts",
    "seo:rankings": "node scripts/seo-rank-tracker.mjs",
    "generate:llms": "node scripts/generate-llms-full.mjs",
    "generate:content": "node scripts/generate-content.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "submit-indexnow": "node scripts/submit-indexnow.mjs",
    "clean": "rm -rf dist .next"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@vercel/postgres": "^0.10.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fuse.js": "^7.5.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.16.0",
    "motion": "^12.23.24",
    "next": "^16.2.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "19.2.17",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@google/genai@2.10.0": true,
    "bufferutil@4.1.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true

{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prebuild": "tsx scripts/generate-llms-txt.mjs",
    "build": "tsx validate-seo.ts && next build",
    "postbuild": "node scripts/postbuild-indexnow.mjs",
    "lint": "tsc --noEmit",
